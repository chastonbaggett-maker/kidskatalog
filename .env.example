# Resend — required to actually email parents the Kart PDF
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=KidsKatalog <onboarding@resend.dev>

# Amazon Associates tag used in catalog affiliate links
NEXT_PUBLIC_AFFILIATE_TAG=kidskatalog-20

# Turso — primary database for catalog, admin PINs, and metrics (recommended)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob — fallback JSON store in production if Turso is not set; also used for toy images
BLOB_READ_WRITE_TOKEN=

# HMAC secret for signing admin session cookies (use a long random string)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-secret

# xAI Grok — used by admin Bulk add / single Import to draft listing fields
XAI_API_KEY=
# Optional override (defaults to grok-4.20-0309-non-reasoning)
# XAI_MODEL=grok-4.20-0309-non-reasoning
# GROK_API_KEY=  # alias for XAI_API_KEY

# Required on Vercel so imported toy photos persist (serverless has no writable public/)
# BLOB_READ_WRITE_TOKEN=

