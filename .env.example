# Resend — unused for Kart share (link-only). Keep only if you send other mail.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=KidsKatalog <onboarding@resend.dev>

# Parent Mode Buy stays a placeholder until BOTH are set.
# Do not flip LIVE until the site is fully up and Associates is approved.
# See docs/associates-flip.md — do not set these on Vercel until Chaston flips.
# AMAZON_ASSOCIATES_LIVE=true
# AMAZON_ASSOCIATES_TAG=your-associates-tag-20

# Public origin for parent share links. Prefer a working host.
# kidskatalog.app is rewritten to vercel.app until DNS is actually live.
NEXT_PUBLIC_SITE_URL=https://kidskatalog.vercel.app

# Stored per-toy affiliateUrl / admin import tag (server-only; never shown to kids)
AFFILIATE_TAG=kidskatalog-20
# Fallback if AFFILIATE_TAG is unset (avoid relying on this in kid bundles)
NEXT_PUBLIC_AFFILIATE_TAG=kidskatalog-20

# Turso — primary database for catalog, admin PINs, metrics, parent accounts, and saved lists
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob — fallback JSON store in production if Turso is not set; also used for toy images
BLOB_READ_WRITE_TOKEN=

# HMAC secret for signing admin session cookies (use a long random string)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-secret

# Optional Bearer token so Chief/bots can POST /api/admin/proposals without a PIN cookie.
# Approve / Reject / Submit Approval still require the admin PIN session.
# ADMIN_INGEST_KEY=

# HMAC secret for Parent Mode password sessions (falls back to ADMIN_SESSION_SECRET)
PARENT_SESSION_SECRET=change-me-to-a-long-random-parent-secret

# Optional Clerk for Parent Mode sign-up / log in. Leave unset to use the password form.
# See docs/parent-auth.md — do not commit live keys.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# CLERK_SECRET_KEY=sk_test_xxxxxxxx
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/p/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/p/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/p
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/p

# xAI Grok — used by admin Bulk add / single Import to draft listing fields
XAI_API_KEY=
# Optional override (defaults to grok-4.20-0309-non-reasoning)
# XAI_MODEL=grok-4.20-0309-non-reasoning
# GROK_API_KEY=  # alias for XAI_API_KEY

# Required on Vercel so imported toy photos persist (serverless has no writable public/)
# BLOB_READ_WRITE_TOKEN=
